{
  "services": {
    "api": {
      "root": "./",
      "entrypoint": "Dockerfile.vercel",
      "framework": null
    },
    "worker": {
      "root": "./",
      "entrypoint": "Dockerfile.worker.vercel",
      "framework": null
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "api" } }
  ]
}
