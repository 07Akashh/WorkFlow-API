NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Leave SMTP_HOST unset to use Nodemailer's JSON transport locally.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=TaskFlow <no-reply@taskflow.local>
