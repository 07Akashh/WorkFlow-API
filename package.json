{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "description": "TaskFlow backend technical assignment",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:start": "node dist/workers/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=true NODE_ENV=test vitest run tests/integration --pool=forks --no-file-parallelism",
    "test:api": "docker compose -f docker-compose.test.yml up -d --wait && NODE_ENV=test DATABASE_URL=postgresql://taskflow:taskflow_test_password@localhost:5433/taskflow_test REDIS_URL=redis://localhost:6380 JWT_ACCESS_SECRET=test-secret-must-be-at-least-32-characters-long TEST_USER_PASSWORD=\"${TEST_USER_PASSWORD:-TaskFlowDev@123}\" npm run test:integration",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "typeorm-ts-node-esm migration:generate src/database/migrations/InitialSchema -d src/config/database.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/config/database.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/config/database.ts",
    "migration:show": "typeorm-ts-node-esm migration:show -d src/config/database.ts",
    "seed": "tsx src/database/seeds/seed.ts",
    "worker": "tsx src/workers/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
